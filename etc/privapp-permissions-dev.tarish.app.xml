<?xml version="1.0" encoding="utf-8"?>
<!--
  Privileged permissions for Tarish.

  A privileged app does not get its privileged permissions merely by being in
  priv-app; each one must be whitelisted here or the device refuses to boot with
  "Failed to grant permission". Keep this list minimal and justified.
-->
<permissions>
    <privapp-permissions package="dev.tarish.app">
        <!--
          Needed to advertise and scan without the throttling and app-op checks applied
          to ordinary apps, and to keep advertising while the screen is off. This is the
          same permission Google grants their sharing app for the same reason.
        -->
        <permission name="android.permission.BLUETOOTH_PRIVILEGED"/>
        <!--
          The device's real Bluetooth Classic address, which goes INSIDE the Quick Share
          endpoint advertisement so a sender knows what to dial for RFCOMM.

          BLUETOOTH_PRIVILEGED is NOT enough for this. getAddress() returns the redacted
          02:00:00:00:00:00 without LOCAL_MAC_ADDRESS, and an advertisement carrying that
          is worse than none: a sender lists the device and cannot connect to it.

          Read-only, and used for one field of one advertisement.
        -->
        <permission name="android.permission.LOCAL_MAC_ADDRESS"/>
    </privapp-permissions>
</permissions>
