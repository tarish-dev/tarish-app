<?xml version="1.0" encoding="utf-8"?>
<!--
  Runtime permissions pre-granted to Tarish at first install.

  BLUETOOTH_ADVERTISE, _SCAN and _CONNECT are runtime permissions on Android 12 and
  later. Being a privileged system app does NOT grant them, and there is no UI to
  request them from a service that runs before anything is opened, so they are granted
  here.

  WHEN THIS FILE IS APPLIED, precisely - it is not "at first install", and the
  difference matters. PackageManagerService re-runs the default-permission pass only when
  it decides the device upgraded:

      mIsUpgrade = !partitionsFingerprint.equals(ver.fingerprint)

  So an image built with a STALE BUILD_NUMBER carries the fingerprint already on the
  phone, is judged "not an upgrade", and every package added by that image arrives with
  nothing granted. Tarish then died in TarishBleService.onCreate on a SecurityException
  and crash-looped - "Tarish keeps stopping", with no way into the app to see why.
  Always build with a fresh BUILD_NUMBER.

  A grant that landed shows `flags=[ GRANTED_BY_DEFAULT ...]` in
  `dumpsys package dev.tarish.app`. That flag is the proof it came from this file rather
  than from someone running `pm grant`, which is otherwise indistinguishable.
-->
<exceptions>
    <exception package="dev.tarish.app">
        <!-- Without it the foreground service posts nothing, and a service that cannot
             show its notification is killed. -->
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false"/>
        <permission name="android.permission.BLUETOOTH_ADVERTISE" fixed="false"/>
        <permission name="android.permission.BLUETOOTH_SCAN" fixed="false"/>
        <permission name="android.permission.BLUETOOTH_CONNECT" fixed="false"/>
        <!--
          WIFI DIRECT. WifiP2pManager refuses without it, so the bandwidth upgrade never
          happens and an off-network transfer silently stays on Bluetooth: ~150 KB/s
          instead of 10.5 MB/s, with nothing in the log saying why.

          Missing from this list until it was caught on hardware - after a sideload every
          other permission here came back GRANTED_BY_DEFAULT and this one did not.
          Declared in the manifest is not granted.
        -->
        <permission name="android.permission.NEARBY_WIFI_DEVICES" fixed="false"/>
    </exception>
</exceptions>
