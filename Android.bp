// Tarish app — built as a privileged system app.
//
// privileged + platform certificate is what BLUETOOTH_PRIVILEGED requires, and is the
// same standing Google gives their own sharing app. Nothing here needs to be an
// updatable APK, so it ships in system_ext alongside the daemons.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "TarishApp",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    // debug/ IS NOT UNDER src/, AND THAT IS THE POINT.
    //
    // DebugBridge opens a local socket that can start a transfer, which is not something a
    // shell on a production device should be able to do — the same reasoning that keeps
    // tarishctl out of a user build. So it is compiled in only when the build is
    // debuggable, and MainActivity reaches it by name so its absence is ordinary rather
    // than a compile error.
    //
    // The first attempt kept it under src/ and listed it in exclude_srcs, adding it back
    // here. That silently produced a build with the CLASS MISSING and everything else
    // intact: Soong gathers srcs and applies exclude_srcs afterwards, so the exclusion
    // wins and the product variable never gets a say. The symptom was a bridge that never
    // started and logged nothing, because the reflective call swallows the absence by
    // design. Keeping the file outside the default glob means nothing has to be excluded.
    product_variables: {
        debuggable: {
            srcs: ["debug/**/*.java"],
        },
    },

    // The IPC contract lives with the daemon, which is the server. The app consumes
    // those files rather than carrying a copy that can drift.
    static_libs: ["dev.tarish-java"],

    // platform_apis rather than an SDK level: this is built in-tree with the platform
    // and uses system API surface.
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,

    optimize: {
        enabled: false,
    },

    required: [
        "privapp-permissions-dev.tarish.app.xml",
        "default-permissions-dev.tarish.app.xml",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-dev.tarish.app.xml",
    src: "etc/privapp-permissions-dev.tarish.app.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "default-permissions-dev.tarish.app.xml",
    src: "etc/default-permissions-dev.tarish.app.xml",
    sub_dir: "default-permissions",
    system_ext_specific: true,
}
