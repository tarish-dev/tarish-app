<?xml version="1.0" encoding="utf-8"?>
<!--
  Tarish — the AirDrop-compatible sharing client.

  Visibility is deliberately tied to the UI. MainActivity turns discovery on in
  onResume and off in onPause, and TarishBleService is started and stopped with it.
  Nothing advertises from boot.

  That is a privacy position, not a limitation: a device that announces itself to every
  AirDrop scanner in range from the moment it powers on is a choice nobody made. It
  also stands in for the per-transfer consent prompt that does not exist yet: the
  daemon accepts any transfer while visible and refuses every one while not, so closing
  the app has to be a real "no".
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.tarish.app">

    <!--
      Android 12 split the old BLUETOOTH/BLUETOOTH_ADMIN pair into these. They are
      RUNTIME permissions even for a privileged app, so they are pre-granted in
      etc/default-permissions-dev.tarish.app.xml — being installed is not enough.

      neverForLocation lets us scan without holding a location permission. Tarish has no
      business knowing where the device is, and BLE scanning is otherwise treated as
      location-capable.
    -->
    <!--
      A transfer that continues after the app is backgrounded needs a foreground service,
      and a foreground service needs a notification the person can see. POST_NOTIFICATIONS
      is a RUNTIME permission, so like the Bluetooth ones it is pre-granted in
      etc/default-permissions-dev.tarish.app.xml; being privileged is not enough.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Privileged, granted through etc/privapp-permissions-dev.tarish.app.xml. -->
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />

    <!--
      WI-FI IS A PRECONDITION, NOT A PREFERENCE.

      With Wi-Fi off, AWDL cannot start at all: the AWDL driver rides the Wi-Fi driver's
      interface, so every radio mode and every channel is refused. Measured on frankel.
      A user with Wi-Fi off therefore sees an app that simply never finds anybody, which
      is exactly what was reported. Without ACCESS_WIFI_STATE we could not even detect
      it, let alone say so.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!--
      setWifiEnabled() has returned false for ordinary apps since API 29. NETWORK_SETTINGS
      is what still permits it, and it is what lets Tarish offer to turn Wi-Fi on and then
      put it back exactly as it was. Without it the app can see that Wi-Fi is off and tell
      the user, but cannot offer to fix it.

      NOT a privileged permission and NOT in privapp-permissions. Its protectionLevel is
      plain "signature", so it is granted by the platform certificate this app is signed
      with. Listing a signature-only permission in the privapp whitelist would be wrong:
      that file exists for signature|privileged permissions, and every entry in it is a
      claim that the permission needs whitelisting to be granted at all.

      It is a powerful permission and it is declared here explicitly rather than relied
      on implicitly.

      An earlier version of this note said the app would inherit it anyway through
      sharedUserId="android.uid.system". That is no longer true and should not be relied
      on: the app dropped the system uid and runs in the platform_app domain, so this is
      granted by the platform signature alone. Nothing else here needs the system uid
      back, and it is NOT to be re-added to obtain a permission.

      It is NOT what joins a Wi-Fi Direct group. That is WifiP2pManager.connect(), which
      needs only NEARBY_WIFI_DEVICES and CHANGE_WIFI_STATE below (see WifiDirectJoiner).
      If the offer-to-enable-Wi-Fi affordance is ever dropped, this permission goes with
      it rather than staying behind "in case".
    -->
    <uses-permission android:name="android.permission.NETWORK_SETTINGS" />

    <!--
      WI-FI DIRECT, for the bandwidth upgrade.

      A Quick Share transfer bootstraps over Bluetooth at around 70 KB/s and the peer then
      offers a faster network. Joining that group is WifiP2pManager.connect() with the
      network name and passphrase the peer sent, which is an ORDINARY runtime
      permission: no system dialog and nothing privileged. Bada does the same with nothing more than
      this, which is what settles it: the privileged half of the negotiation happens on the
      peer's device, where the peer already has it.

      neverForLocation because we do not want, and must not be given, position: the group
      is identified by the name the peer told us over an encrypted channel, not by looking
      at what is nearby.
    -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- BLE advertising is the discovery trigger; without it the device is invisible. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:label="Tarish"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Tarish"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Tarish settings"
            android:parentActivityName=".MainActivity" />

        <!--
          The managed-configuration schema. An MDM reads this to render its console, so
          the app is configurable by Intune, Workspace ONE, SOTI, MobileIron and Jamf
          alike without any vendor-specific integration: they are all setting the same
          AOSP app restrictions.
        -->
        <meta-data
            android:name="android.content.APP_RESTRICTIONS"
            android:resource="@xml/app_restrictions" />

        <service
            android:name=".TarishBleService"
            android:exported="false" />

        <!--
          Keeps a transfer alive once the app is backgrounded. connectedDevice is the
          honest type: the work being protected is a Bluetooth link to another device.

          Not exported. Nothing outside this app has any business starting a transfer
          notification.
        -->
        <service
            android:name=".TransferService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
