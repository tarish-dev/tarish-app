<?xml version="1.0" encoding="utf-8"?>
<!--
  Barq — the AirDrop-compatible sharing client.

  Visibility is deliberately tied to the UI. MainActivity turns discovery on in
  onResume and off in onPause, and BarqBleService is started and stopped with it.
  Nothing advertises from boot.

  That is a privacy position, not a limitation: a device that announces itself to every
  AirDrop scanner in range from the moment it powers on is a choice nobody made. It
  also stands in for the per-transfer consent prompt that does not exist yet: the
  daemon accepts any transfer while visible and refuses every one while not, so closing
  the app has to be a real "no".
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.barq.app"
    android:sharedUserId="android.uid.system">

    <!--
      Android 12 split the old BLUETOOTH/BLUETOOTH_ADMIN pair into these. They are
      RUNTIME permissions even for a privileged app, so they are pre-granted in
      etc/default-permissions-dev.barq.app.xml — being installed is not enough.

      neverForLocation lets us scan without holding a location permission. Barq has no
      business knowing where the device is, and BLE scanning is otherwise treated as
      location-capable.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Privileged, granted through etc/privapp-permissions-dev.barq.app.xml. -->
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />

    <!-- BLE advertising is the discovery trigger; without it the device is invisible. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:label="Barq"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Barq"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BarqBleService"
            android:exported="false" />
    </application>
</manifest>
