<?xml version="1.0" encoding="utf-8"?>
<!--
  Tarish's SEMANTIC colours, light theme.

  The raw brand ramps live in brand_ramps.xml exactly as the brand kit ships them; nothing
  here invents a colour. This file only says which rung of which ramp plays which role, and
  res/values-night/colors.xml answers the same questions for dark.

  WHY NOT tokens/themes.xml FROM THE KIT: those declare parent="Theme.Material3.*", which
  comes from the Material Components library. This app does not depend on it - it is a plain
  AOSP app whose views are built in code - so the same tokens are expressed as colour
  resources instead. The VALUES are the kit's, unchanged.

  Ui.java reads these through Context.getColor, which is what makes light and dark work at
  all: a static final int cannot follow the theme.
-->
<resources>
    <!-- Ground and raised surfaces. -->
    <color name="t_bg">@color/basalt_50</color>
    <color name="t_surface">@color/basalt_0</color>
    <color name="t_surface_sunk">@color/basalt_100</color>
    <!--
      Hairlines are DELIBERATELY quiet - do not "fix" these to pass 3:1.

      Measured, they are 1.79:1 against a card and 1.69:1 against the ground (1.43 and 1.55
      in dark). That looks like a WCAG 1.4.11 failure and is not one: the criterion covers
      visual information needed to IDENTIFY a component or its state, and explicitly exempts
      decoration. These rules group rows and edge cards; nothing about them says what a
      control is or what state it is in. The brand's whole surface language is hairlines
      instead of cards, and raising them to 3:1 would read as a table grid.

      Where a boundary IS the only thing identifying a control, it needs its own treatment
      rather than a louder global rule. The one to watch is the PIN field, whose fill
      (surface_sunk) sits very close to the ground - the 32sp mono hint "0000" is doing most
      of the work of saying "type here". Worth a look on a real screen.
    -->
    <color name="t_surface_edge">@color/basalt_300</color>
    <color name="t_rule">@color/basalt_300</color>

    <!--
      Signal amber: the brand, the send action, active transfers.

      Light uses signal_700 rather than the bright 300 the dark theme uses. Amber at full
      brightness on a near-white ground fails contrast badly - the kit's own measured table
      puts brand-on-ground at 4.86:1 for light using this rung, and it would be about 1.5:1
      with signal_300.
    -->
    <color name="t_accent">@color/signal_700</color>
    <color name="t_accent_fill">@color/signal_700</color>
    <color name="t_accent_dim">@color/signal_100</color>
    <color name="t_on_accent">@color/basalt_0</color>

    <!-- Jade: received and complete. Never the brand. -->
    <color name="t_live">@color/jade_700</color>

    <!-- Ember: failures and destructive actions ONLY. -->
    <color name="t_error">@color/ember_700</color>

    <!-- Azure: informational, used sparingly. -->
    <color name="t_info">@color/azure_700</color>

    <color name="t_text">@color/basalt_900</color>
    <color name="t_text_muted">@color/basalt_600</color>
    <color name="t_text_faint">@color/basalt_500</color>

    <!--
      The launcher icon's own colours, which are NOT theme-dependent: an adaptive icon is
      one artwork whatever the system theme is.
    -->
    <color name="tarish_ink">@color/basalt_950</color>
    <color name="tarish_ink_lift">@color/basalt_900</color>
    <color name="tarish_amber">@color/signal_300</color>
    <color name="tarish_amber_deep">@color/signal_500</color>
</resources>
