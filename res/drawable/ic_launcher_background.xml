<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-bleed basalt with a warm off-centre glow, from the brand kit's
  app-icon/ic_launcher_background.svg.

  The kit also ships a flat #0C0B08 shape as a fallback; this is the gradient version, which
  is what the guidelines describe as the background layer. Converted by hand because the kit
  ships the gradient only as SVG.

  SVG radial gradients are in objectBoundingBox units - cx=.32 cy=.20 r=1.0 of a 108x108 box -
  so they become absolute viewport coordinates here: centre (34.56, 21.6), radius 108.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="34.56"
                android:centerY="21.6"
                android:gradientRadius="108">
                <item android:offset="0" android:color="#2C2719"/>
                <item android:offset="1" android:color="#0C0B08"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
