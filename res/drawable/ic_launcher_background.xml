<?xml version="1.0" encoding="utf-8"?>
<!--
  Not a flat fill. A radial lift behind the mark gives the bolt something to sit in,
  so the icon reads as lit from within rather than as a sticker on black.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="48"
                android:gradientRadius="62"
                android:startColor="@color/tarish_ink_lift"
                android:endColor="@color/tarish_ink" />
        </aapt:attr>
    </path>
</vector>
