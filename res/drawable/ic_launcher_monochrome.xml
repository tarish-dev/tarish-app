<?xml version="1.0" encoding="utf-8"?>
<!--
  The same silhouette in one colour, for Material You themed icons: Android tints this from
  the wallpaper. The brand kit says to ship it, and without it a themed-icon launcher falls
  back to a flat generic tile.

  Note what is NOT here: the fold. The monochrome layer is a silhouette, so a fold drawn in
  the same single colour would be invisible - the kit's own SVG omits it for that reason.
  Everything is solid black; the system supplies the colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="23.5346"
        android:translateY="25.3907"
        android:scaleX="0.640030"
        android:scaleY="0.640030">
        <path
            android:pathData="M18.5,38 H34 L48,52 V79.5 a8.5,8.5 0 0 1 -8.5,8.5 H18.5 a8.5,8.5 0 0 1 -8.5,-8.5 V46.5 a8.5,8.5 0 0 1 8.5,-8.5 Z"
            android:fillColor="#000000"/>
        <path
            android:pathData="M50.495,26.262 A12,12 0 0 1 59.971,37.163"
            android:strokeColor="#000000"
            android:strokeWidth="8.5"
            android:strokeLineCap="round"/>
        <path
            android:pathData="M52.678,15.992 A22.5,22.5 0 0 1 70.445,36.430"
