<?xml version="1.0" encoding="utf-8"?>
<!--
  download.svg from the brand kit, unchanged: 24px grid, 2px stroke, round caps and joins,
  the same geometry as the mark's waves.

  The kit's icons use stroke="currentColor" so they inherit text colour. A VectorDrawable
  has no such thing, so the stroke is white here and Glyph applies the real colour with
  setImageTintList - a tint is a SRC_IN colour filter over the whole drawable, which is
  what reproduces currentColor. Do not hardcode a brand colour in this file; it has to
  work in both themes and in whatever role the call site is using it for.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12 3.5v11.5 M7.5 10.5 12 15l4.5-4.5 M4.5 19.5h15"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
